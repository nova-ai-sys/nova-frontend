# Where the NOVA API is listening.
#
# Leave it unset for local development: the Vite dev server proxies /api to
# http://localhost:8000, so the browser talks to one origin and there is no
# CORS in play. Set it for a built frontend served from somewhere else.
# VITE_API_URL=http://localhost:8000

# Published documentation bundle, from the nova-docs repository. When set, the
# docs update without updating NOVA; the copy in public/ is the offline
# fallback either way.
# VITE_DOCS_BUNDLE_URL=https://nova-ai-sys.github.io/nova-docs/docs-bundle.json

# Extra hostnames allowed to reach the dev server through a proxy or tunnel,
# comma separated. Useful when testing on a phone.
# VITE_ALLOWED_HOSTS=
# VITE_TUNNEL_HOST=
